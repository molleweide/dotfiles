	fi

	if [[ -n "$option_tags" ]]; then
		option_env+=("DOOM_LOAD_TAGS=$option_tags")
	fi

	local final_command=(env "${option_env[@]}" "$nvim_bin" "${option_nvim_flags[@]}")

	echo-join '.' -- "${final_command[*]}"

	# printf '%s ' "${final_command[@]}"

	# env "$"

	if [[ "$option_dry_run" == 'no' ]]; then
