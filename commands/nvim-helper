	function help {
		cat <<-EOF >/dev/stderr
			ABOUT:

			Run [nvim] command with flags or custom environment.

			USAGE:
			nvim-helper [...<options>]

			ACTIONS/PICKERS:
			$(declare -F | awk '{print "    " $3}' | grep 'picker__' | sed 's/picker__//')

			OPTIONS:

			--stdin
			          Pass data and options to a picker with Dorothy's own API wrapper.

			--section=<string>
			    String can be a comma separated list of module sections. Exclude
			    sections by prefixing with [!].

			--tags=<string>
			    String should be a comma separated list of tags. Load only modules
			    with specific tags, OR, exclude them by prefixing with [!].


		EOF
		if [[ $# -ne 0 ]]; then
			echo-error "$@"
		fi
		return 22 # EINVAL 22 Invalid argument
	}

	local item option_dry_run='no' option_env=() option_nvim_flags=()

	local option_sections='' option_tags=''

	while [[ $# -ne 0 ]]; do
		item="$1"
		shift
		case "$item" in
		'--help' | '-h') help ;;
		'--dry' | '-d') option_dry_run='yes' ;;
		'--mode'=*) option_env+=("DOOM_STARTUP_MODE=${item#*=}") ;;

		'--sections='*) option_sections="${item#*=}" ;;
		'--tags='*) option_tags="${item#*=}" ;;
		'--exclude-sections='*) option_sections="!${item#*=}" ;;
		'--exclude-tags='*) option_tags="!${item#*=}" ;;

