	#==================================================================
	# Version 4 w/fzf browser

	# plist-crud-multi.sh — plist CRUD with multi-key read/write/delete + browse via fzf
	# Usage:
	#   ./plist-crud-multi.sh read <domain_or_plist_path> <keypath1> [keypath2 ...]
	#   ./plist-crud-multi.sh write <domain_or_plist_path> <type> <keypath1> <value1> [<keypath2> <value2> ...]
	#   ./plist-crud-multi.sh delete <domain_or_plist_path> <keypath1> [keypath2 ...]
	#   ./plist-crud-multi.sh browse <domain_or_plist_path>

	PLISTBUDDY="/usr/libexec/PlistBuddy"

	function plist_path() {
		if [[ "$1" == /* ]]; then
			echo "$1"
		else
			echo "$HOME/Library/Preferences/$1.plist"
		fi
	}

	# Recursively print keys in dot notation with values, using PlistBuddy
	function dump_keys() {
		local plistfile="$1"
		local prefix="$2"
		local keys

		# Get keys at current level
		keys=$($PLISTBUDDY -c "Print $prefix" "$plistfile" 2>/dev/null |
			awk '/^Dict {$/ {print "__DICT__"} /^Array {$/ {print "__ARRAY__"} /^[[:space:]]*[^ ]+ = / {print $1}' |
			grep -v '__DICT__' | grep -v '__ARRAY__')

		# If prefix is empty, we start at root:
		if [[ "$prefix" == "" ]]; then
			keys=$($PLISTBUDDY -c "Print" "$plistfile" 2>/dev/null |
				awk '/^[^ ]/ {print $1}' | tr -d ';')
		fi

		# Get raw keys at current level
		keys=$($PLISTBUDDY -c "Print $prefix" "$plistfile" 2>/dev/null |
			awk -F'= ' '/^[[:space:]]*[^ ]+ = / {print $1}' | tr -d ' ')

		# Fallback if no keys found
		if [[ -z "$keys" ]]; then
			return
		fi

		while IFS= read -r key; do
			# Compose full key path
			if [[ -z "$prefix" ]]; then
				fullkey="$key"
			else
				fullkey="$prefix:$key"
			fi

			# Check type of this key
			type=$($PLISTBUDDY -c "Print $fullkey" "$plistfile" 2>&1)
			if [[ "$type" == *"Dict"* ]]; then
				dump_keys "$plistfile" "$fullkey"
			elif [[ "$type" == *"Array"* ]]; then
				# For arrays, print each index recursively
				count=$($PLISTBUDDY -c "Print $fullkey" "$plistfile" 2>/dev/null | grep -c '^[[:space:]]*[^ ]')
				for ((i = 0; i < count; i++)); do
					dump_keys "$plistfile" "$fullkey:$i"
				done
			else
				# Print key and value in dot notation
				val=$($PLISTBUDDY -c "Print $fullkey" "$plistfile" 2>/dev/null | tr -d '\n')
				# Replace ':' by '.' for dot notation
				dotkey="${fullkey//:/\.}"
				echo "$dotkey = $val"
			fi
		done <<<"$keys"
	}

	cmd="$1"
	domain_or_path="$2"
	shift 2

	plistfile=$(plist_path "$domain_or_path")

	if [[ -z "$cmd" || -z "$domain_or_path" ]]; then
		echo "Usage:"
		echo "  $0 read <domain_or_plist_path> <keypath1> [keypath2 ...]"
		echo "  $0 write <domain_or_plist_path> <type> <keypath1> <value1> [<keypath2> <value2> ...]"
		echo "  $0 delete <domain_or_plist_path> <keypath1> [keypath2 ...]"
		echo "  $0 browse <domain_or_plist_path>"
