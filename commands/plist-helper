	PLISTBUDDY="/usr/libexec/PlistBuddy"

	function plist_path() {
		if [[ "$1" == /* ]]; then
			echo "$1"
		else
			echo "$HOME/Library/Preferences/$1.plist"
		fi
	}

	cmd="$1"
	domain="$2"
	keypath="$3"

	case "$cmd" in
	read)
		if [[ -z "$keypath" ]]; then
			defaults read "$domain"
		else
			$PLISTBUDDY -c "Print :$keypath" "$(plist_path "$domain")"
		fi
		;;
	write)
		type="$4"
		value="$5"
		$PLISTBUDDY -c "Set :$keypath $value" "$(plist_path "$domain")" 2>/dev/null ||
			$PLISTBUDDY -c "Add :$keypath $type $value" "$(plist_path "$domain")"
		;;
	delete)
		$PLISTBUDDY -c "Delete :$keypath" "$(plist_path "$domain")"
		;;
	*)
		echo "Usage:"
		echo "  prefctl read domain [keypath]"
		echo "  prefctl write domain keypath type value"
		echo "  prefctl delete domain keypath"
		echo "Types: string, bool, integer, real, dict, array"
		exit 1
		;;
	esac

	#==================================================================
	# version 2

	### How to use it

	# 1. **Make it executable**
	#
	# ```bash
	# chmod +x plist-crud.sh
	# ```
	#
	# 2. **Read a whole plist domain or plist file**
	#
	# ```bash
	# ./plist-crud.sh read com.apple.finder
	# ./plist-crud.sh read /path/to/some.plist
	# ```
	#
	# 3. **Read a nested key**
	#
	# ```bash
	# ./plist-crud.sh read com.apple.finder DesktopViewSettings:IconViewSettings:arrangeBy
	# ```
	#
	# 4. **Write/update a nested key**
	#
	# ```bash
	# ./plist-crud.sh write com.apple.finder DesktopViewSettings:IconViewSettings:arrangeBy string grid
	# ```
	#
	# 5. **Delete a nested key**
	#
	# ```bash
	# ./plist-crud.sh delete com.apple.finder DesktopViewSettings:IconViewSettings:arrangeBy
	# ```

	# plist-crud.sh — A simple plist Create/Read/Update/Delete CLI tool
	# Usage:
	#   ./plist-crud.sh read <domain_or_plist_path> [keypath]
	#   ./plist-crud.sh write <domain_or_plist_path> <keypath> <type> <value>
	#   ./plist-crud.sh delete <domain_or_plist_path> <keypath>
	#
	# keypath uses ':' as a delimiter for nested dictionaries, e.g., EnvVars:BAZ

	PLISTBUDDY="/usr/libexec/PlistBuddy"

	function plist_path() {
		# If argument is a full path, use it. Otherwise, build path under ~/Library/Preferences/
		if [[ "$1" == /* ]]; then
			echo "$1"
		else
			echo "$HOME/Library/Preferences/$1.plist"
		fi
	}

	cmd="$1"
	domain_or_path="$2"
	keypath="$3"

	if [[ -z "$cmd" || -z "$domain_or_path" ]]; then
		echo "Usage:"
		echo "  $0 read <domain_or_plist_path> [keypath]"
		echo "  $0 write <domain_or_plist_path> <keypath> <type> <value>"
		echo "  $0 delete <domain_or_plist_path> <keypath>"
		exit 1
	fi

	plistfile=$(plist_path "$domain_or_path")

	case "$cmd" in
	read)
		if [[ -z "$keypath" ]]; then
			# Read whole plist (top-level)
			defaults read "${domain_or_path}"
		else
			# Read nested key
			$PLISTBUDDY -c "Print :$keypath" "$plistfile"
		fi
		;;
	write)
		type="$4"
		value="$5"
		if [[ -z "$keypath" || -z "$type" || -z "$value" ]]; then
			echo "Usage: $0 write <domain_or_plist_path> <keypath> <type> <value>"
			exit 1
		fi

		# Try setting existing key; if it fails, add new key
		$PLISTBUDDY -c "Set :$keypath $value" "$plistfile" 2>/dev/null ||
			$PLISTBUDDY -c "Add :$keypath $type $value" "$plistfile"
		;;
	delete)
		if [[ -z "$keypath" ]]; then
			echo "Usage: $0 delete <domain_or_plist_path> <keypath>"
			exit 1
		fi

		$PLISTBUDDY -c "Delete :$keypath" "$plistfile"
		;;
	*)
		echo "Unknown command: $cmd"
		echo "Usage:"
		echo "  $0 read <domain_or_plist_path> [keypath]"
		echo "  $0 write <domain_or_plist_path> <keypath> <type> <value>"
		echo "  $0 delete <domain_or_plist_path> <keypath>"
		exit 1
		;;
	esac

