    # Recursively dump keys and values in dot notation with awk formatting
    function dump_keys_awk() {
        local plistfile="$1"

        # Dump plist to XML (or text) format to parse key-value pairs recursively
        # We'll use PlistBuddy Print and parse its indented output:
        $PLISTBUDDY -c "Print" "$plistfile" 2>/dev/null |
            awk '
    BEGIN {
        FS="=";
        indent = 0;
    }
    # Track nesting level by indentation
    {
        line = $0;
        gsub(/^[ \t]+/, "", line);
        level = (length($0) - length(line)) / 4;
        keyval[level] = "";

        # Handle keys and values
        if (match(line, /^[^ ]+ = /)) {
            split(line, arr, "=");
            key = arr[1];
            gsub(/^[ \t]+|[ \t]+$/, "", key);
            val = substr(line, index(line, "=") + 2);
            gsub(/^[ \t]+|[ \t]+$/, "", val);

            # Build full key path from keys in higher levels
            keyval[level] = key;
            fullpath = keyval[0];
            for (i=1; i<=level; i++) {
                if (keyval[i] != "") {
                    if (fullpath != "")
                        fullpath = fullpath "." keyval[i];
                    else
                        fullpath = keyval[i];
                }
            }
            # Output full key path = value
            print fullpath " = " val;
        } else if (match(line, /^Dict {$/) || match(line, /^Array {$/)) {
            # Handle opening dict or array - keep key path for nesting
            # keyval[level] is already set from previous line
            # Nothing to print here
        } else if (match(line, /^}$/)) {
            # End of dict/array - clear keyval for this level
            keyval[level] = "";
        }
    }
    '
    }

    # toggle plist bool
    toggle_plist_bool() {
        local plist_path="$1"
        local key_path="$2"
        local plistbuddy="/usr/libexec/PlistBuddy"

        # Check if plist exists
        if [[ ! -f "$plist_path" ]]; then
            echo "Plist file not found: $plist_path"
            return 1
        fi

        # Check if key exists
        if ! $plistbuddy -c "Print $key_path" "$plist_path" &>/dev/null; then
            echo "Key '$key_path' does not exist in $plist_path"
            return 1
        fi

        # Check type of key
        local type=$($plistbuddy -c "Print $key_path" "$plist_path" 2>&1 | grep -Eo '^(true|false|string|integer|real|dict|array|date|data)$' || true)

        if [[ "$type" != "true" && "$type" != "false" ]]; then
            echo "Key '$key_path' is not a boolean (it's $type), cannot toggle."
            return 1
        fi

        # Read current value
        local current=$($plistbuddy -c "Print $key_path" "$plist_path")

        if [[ "$current" == "true" ]]; then
            $plistbuddy -c "Set $key_path false" "$plist_path"
            echo "Toggled $key_path to false"
        elif [[ "$current" == "false" ]]; then
            $plistbuddy -c "Set $key_path true" "$plist_path"
            echo "Toggled $key_path to true"
        else
            echo "Unexpected value '$current' for boolean key."
            return 1
        fi
    }

    #==================================================================
    # Args

    function help {
        cat <<-EOF >/dev/stderr
			ABOUT

			USAGE
			plist-helper --source=<path> [...<option>] <action> -- [...<argument>]
			plist-helper --domain=<path> --get [-- ...<key>]
			plist-helper --domain=<path> --set -- <type1> <keypath1> <value1> [<type2> <keypath2> <value2> ...]
			plist-helper --domain=<path> --add -- <type1> <keypath1> <value1> [<type2> <keypath2> <value2> ...]


			EXAMPLE: PRINT BASIC OUTPUT
			plist-helper --domain=<path> --print

			EXAMPLE: PRINT XML
			plist-helper --domain=<path> --print=xml

			EXAMPLE: PRINT FORMATTED (FLATTENED TREE)
			plist-helper --domain=<path> --print=formatted
			plist-helper --domain=<path> --print=truncated # truncate very long value strings for better display in eg. fzf.

			EXAMPLE: SET MULTIPLE KEYS
			plist-helper --source=<path> --set -- \
			    "'Palo Alto Networks':GlobalProtect:PanSetup:Portal string vpn.example.com" \
			    "'Palo Alto Networks':GlobalProtect:PanSetup:Prelogon integer 0"



			CURRENT CHATGPT OUTPUT USAGE
			echo "  $0 read <domain_or_plist_path> <keypath1> [keypath2 ...]"
			echo "  $0 write <domain_or_plist_path> <type> <keypath1> <value1> [<keypath2> <value2> ...]"
			echo "  $0 delete <domain_or_plist_path> <keypath1> [keypath2 ...]"


			OPTIONS

		EOF
        if [[ $# -ne 0 ]]; then
            echo-error "$@"
        fi
        return 22 # EINVAL 22 Invalid argument
    }

    # process
    local domain='' action='' option_verbose='no' option_quiet='no' option_print_style='' plist_action_args=()
    local option_output_format=''

    while [[ $# -ne 0 ]]; do
        item="$1"
        shift
        case "$item" in
        '--help' | '-h') help ;;
        '-V' | '--verbose') option_verbose='yes' ;;
        '--quiet') option_quiet='yes' ;;
            # defaults read <file>
            # plutil -p
            # plistbuddy -c "Print" <file>
            # plistbuddy -x -c "Print" <file>
        '--domain='*) domain="${item#*=}" ;;
        '--print') action='print' ;;
        '--use='*) option_output_format="${item#*=}" ;;

        # defaults | plutil | pb | xml
        '--print='*) action='print' option_print_style="${item#*=}" ;; # operates on the whole file
        '--interactive') ;;                                            # plistbuddy interactive mode
        # basic operations
        '--get') action='get' ;;
        '--set') action='set' ;;
        '--add' | '--add-set') action='add' ;;
        '--delete') action='delete' ;;
        '--browse') action='browse' ;;
        '--browse-domains') action='browse_domains' ;;
        # specific operations
        '--toggle') ;;
        '--incr') ;;
        '--decr') ;;
        '--maximize') ;;
        '--minimize') ;;
        # '--question='*) option_question+=("${item#*=}") ;;
        # '--no-label'* | '--label'*)
        # 	# label can be 'yes', 'no', and 'first'
        # 	option_label="$(get-flag-value --fallback="$option_label" -- "$item")"
        # 	;;
        '--')
            plist_action_args+=("$@")
            # shift $#
            break
            ;;
        '--'*) help "An unrecognised flag was provided: $item" ;;
        *) help "An unrecognised flag was provided: $item" ;;
        esac
