    if [[ -z "$domain" && ! "$action" =~ ^(browse_domains|abcde)$ ]]; then
        help "No domain was provided"
    fi

    if [[ -z "$action" ]]; then
        help "No action was provided"
    fi

    local PLISTBUDDY="/usr/libexec/PlistBuddy" \
        plistfile=''

    plistfile="$(plist_path "$domain")"

    # echo "plistfile: [$plistfile]"

    # exit

    #==================================================================
    # Act

    if [[ "$action" == "print" ]]; then

        case "$option_print_style" in
        '' | defaults) defaults read "$plistfile" ;;
        plutil) plutil -p "$plistfile" ;;
        pb) $PLISTBUDDY -c "print" "$plistfile" ;;
        xml) $PLISTBUDDY -x -c "print" "$plistfile" ;;
        *) help "Unsupported print argument [$option_print_style]" ;;
        esac

    elif [[ "$action" == "get" ]]; then
        # Read whole plist
        if [[ "${#plist_action_args[@]}" -eq 0 ]]; then
            defaults read "$plistfile"
            exit 0

        elif [[ "$option_verbose" == 'yes' ]]; then
            while (($#)); do
                key="$1"
                shift 1
                echo "Key = [$key]"
                $PLISTBUDDY -c "Print :$key" "$plistfile" 2>/dev/null || echo "  (not found)"
            done
        else
            while (($#)); do
                key="$1"
                shift 1
                $PLISTBUDDY -c "Print :$key" "$plistfile" 2>/dev/null || echo "  (not found)"
            done
        fi
        exit 0

    elif [[ "$action" == "set" ]]; then

        # NOTE: Setting assumes that the key already exists, otherwise, use --add

        # ensure each input is a tripple: <type> <keypath> <value>
        if [[ "${#plist_action_args[@]}" -lt 2 || $(("${#plist_action_args[@]}" % 2)) -ne 0 ]]; then
            echo "[$action]: Each action argument has to be a tuple pair: [<key> <value>]"
            exit 1
        fi

        while (($#)); do
            # type="$1"
            key="$1"
            value="$2"
            shift 2
            # Try to Set existing key, else Add new key
            $PLISTBUDDY -c "Set :$key $value" "$plistfile" 2>/dev/null ||
                [[ "$option_quiet" == 'no' ]] && echo "[$action]: Key '$key' not found"
            # $PLISTBUDDY -c "Add :$key $type $value" "$plistfile"
        done

    elif [[ "$action" == "add" ]]; then

        # ensure each input is a tripple: <type> <keypath> <value>
        if [[ "${#plist_action_args[@]}" -lt 3 || $(("${#plist_action_args[@]}" % 3)) -ne 0 ]]; then
            echo "[$action]: Each action argument has to be a triple: [<type> <key> <value>]"
            exit 1
        fi

        while (($#)); do
            type="$1"
            key="$2"
            value="$3"
            shift 3
            # Try to Set existing key, else Add new key
            local status=0

            # $PLISTBUDDY -c "Add :$key $type $value" "$plistfile"

            # $PLISTBUDDY -c "Set :$key $value" "$plistfile" 2>/dev/null ||
            $PLISTBUDDY -c "Add :$key $type $value" "$plistfile" 2>/dev/null || status=$?
            # echo "[$action] Key status: $status"
            if [[ "$status" -ne 0 ]]; then
                [[ "$option_quiet" == 'no' ]] && echo "[$action] Key '$key' already exists"
            fi
        done

    elif [[ "$action" == "delete" ]]; then

        echo "#args: $#"

        if [[ $# -eq 0 ]]; then
            echo "[$action]: Usage: $0 delete <domain_or_plist_path> <keypath1> [keypath2 ...]"
            exit 1
        fi

        for key in "$@"; do
            local status=0
            $PLISTBUDDY -c "Delete :$key" "$plistfile" 2>/dev/null || status=$?
            if [[ $status -ne 0 ]]; then
                [[ "$option_quiet" == 'no' ]] && echo "[$action]: Key '$key' not found"
            fi
        done

    elif [[ "$action" == 'browse' ]]; then

        if ! command -v fzf >/dev/null 2>&1; then
            echo "[$action]: fzf not found! Please install fzf to use browse."
            exit 1
        fi
        dump_keys_awk "$plistfile" "" | fzf --ansi --preview="echo {}"

    elif [[ "$action" == 'browse_domains' ]]; then
        local selection title

        selection="$(defaults domains | tr ',' '\n' | fzf | echo-trim-each-line --stdin)"

        # xargs -I{} defaults read "{}"
        # defaults domains | tr ',' '\n' | fzf | echo-trim-each-line --stdin | xargs -I {} defaults read "{}"

        title="Displaying domain: [$selection]"

        echo-style --h1="$title"

        if [[ "$option_output_format" == xml ]]; then
            "$PLISTBUDDY" -x -c "Print" "$selection"
        else
            defaults read "$selection"
            # defaults read com.apple.Preferences
        fi

        echo-style --g1="$title"
    fi
)

# fire if invoked standalone
if test "$0" = "${BASH_SOURCE[0]}"; then
