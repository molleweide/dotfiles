        option_picker_program="fzf" \
        option_picker_program_args=() \
        option_disable_tmux='no' \
        option_disable_default_styles='no'

    while test "$#" -ne 0; do
        item="$1"
        shift
        case "$item" in
        '--help' | '-h') help ;;
            # Disabling tmux is necessary with eg. `launcher` command, bc the
            # tmux check prevents the focus switch to the newly spawned window.
        '--no-tmux') option_disable_tmux='yes' ;;

        '--no-default-style') option_disable_default_styles='yes' ;;

            # TODO: Actions should not be in this file. >> pickers-*
            # ^ All args after -- are passed down to the picker program.
        '--')
            option_picker_program_args+=("$@")
            shift $#
            break
            ;;
        *)
            help "An unrecognised argument was provided: $item"
            ;;
        esac
    done

