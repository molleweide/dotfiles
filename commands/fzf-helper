function fzf_helper() (
  source "$DOROTHY/sources/bash.bash"
  source "$DOROTHY/sources/stdinargs.bash"

  # ===========================================================================
  # FZF HELPER | INTERNAL HELPERS
  #

  local DEBUG_FZF="yes"

  local LOG_FILE="$DOROTHY/user/fzf_log.txt"

  function logger {
    echo-lines --prefix="[${FUNCNAME[1]}] $1 " -- "${@:1}" >/dev/tty
  }

  __debug_lines() {
    if [[ "$DEBUG_FZF" == "yes" ]]; then
      __print_lines "[fzf-helper]: $1" >>"$LOG_FILE"
    fi
  }

  # ===========================================================================
  # PICKER RUN COMMANDS
  #

  # TODO: If not running from `choose` then add:
  # --bind='ctrl-z:GO BACK TO MASTER PICKER'
  # TODO: Dynamically put together keybinds-legend, that is shown on above the
  # search list.
  # --header $'CTRL-O (open in browser) ╱ ALT-E (open in editor)\n\n' \
  # >>> In order to do this I need to investigate more how to update how
  # to go from picker A into picker B, or how to refresh data, since.
  #
  # TEST: picker__branches use a bind to toggle new picker with additional data.
  # Try calling `fzf-helper git_branches_all` instead and see what happens,
  # when I call a new picker from within another picker
  #
  # HACK: Changing everything in an fzf picke can be done with TRANSFORM ACTIONS
  #
  # TODO: if FZF is open, then apply the changes by reloading everything
  # via FZF actions.

  # ---------------------------------

  # TODO: Make this into different "presets" that you can pass.

  local FZF_DEFAULT_OPTS=(
    --height=50% --tmux 90%,70%
    --layout=reverse --multi --min-height=20 --border
    --border-label-pos=2
    --color='header:italic:underline,label:blue'
    --preview-window='right,50%,border-left'
    --bind='ctrl-d:change-preview-window(down,50%,border-top|hidden|)'
  )

  run_picker_fzf() {

    local fzf_options=() fzf_options_use_defaults='yes' fzf_args=()
    while test "$#" -ne 0; do
      item="$1"
      shift
      case "$item" in
      '--no-defaults')
        fzf_options_use_defaults='no'
        ;;
      '--')
        fzf_args+=("$@")
        shift $#
        break
        ;;
      esac
    done

    if [[ "$fzf_options_use_defaults" == 'yes' ]]; then
      __debug_lines "adding default opts" >/dev/tty
      fzf_options=("${FZF_DEFAULT_OPTS[@]}")
    fi

    # add input args
    fzf_options+=("${fzf_args[@]}")

    # # Loop over args and print them
    # # Then, process them and add defaults to header.
    # for item in "${fzf_options[@]}"; do
    #   __print_lines "> $item"
    # done

    fzf "${fzf_options[@]}"

  }

  # ===========================================================================
  # Internal Pickers
  #

  # # warn: This one does not work at the moment. Needs update to latest pattern.
  # #
  # # --header "$(get_fzf_heading "You have to select an ACTION")"
  # # "${fzf_base_opts[@]}"
  # picker__default() {
  #   __print_lines "${pipe_inputs[@]}" | run_picker_fzf -- \
  #     --border-label '🌴 [Dorothy]: Choose' \
  #     --header $'CTRL-X (remove worktree)\n\n' \
  #     --cycle
  # }

  # # TODO: Ensure this is fully compatible with choose API
  # # - ( ) trim tail from label and show in preview window
  # # - ( ) toggle between selection / cancel
  # picker__choose_test() {
  #   choose "CHOOSE: Select desired dishes from our menu." --linger --required --confirm --multi \
  #     --label \
  #     --label=first \
  #     --visual='${LABEL@U} = ${VALUE-}' --default-fuzzy=burger \
  #     --return='Selected: ${VALUE-}' \
  #     --plugin=fzf \
  #     -- main burger main kebab soda coke soda fanta alkohol LeWine alkohol Carlsberg33c desert cake desert icecream
  #   # because fzf-helper is called recursively, we need to exit immediately
  #   # here in our test
  #   exit 0
  # }

  # =====================================
  # Help

  function help {
    cat <<-EOF >/dev/stderr
			ABOUT:

			Only the last supplied action will be ran.

			Defaults to running a master picker that lists all existing pickers

			1. Entry inputs: Takes either --stdin or -- ...<item> as element data.
			2. You can supply an <action> which will then be used over inputs.

			USAGE:
			fzf-helper [...<picker-options>] [<action>] [-- [...<stdin-options>] [-- [...<item>]]]

			SUPPORTED PICKERS

			  [x] fzf
			  [ ] skim
			  [ ] nucleo

			PICKERS:
			...todo; reuse the collector from picker__master.

			OPTIONS:

			--stdin
			      Pass data and options to a picker with Dorothy's own API wrapper.


		EOF
    if [[ $# -ne 0 ]]; then
      echo-error "$@"
    fi
    return 22 # EINVAL 22 Invalid argument
  }

  # ===========================================================================
  # Arguments

  local item action='' option_target_picker='fzf' option_picker_args=() option_stdin_args=()
  while test "$#" -ne 0; do
    item="$1"
    shift
    case "$item" in
    '--help' | '-h') help ;;
    '--internal-action='*) action+=("${item#*=}") ;;
    '--picker-target='*) option_target_picker="${item#*=}" ;;
    '--')
      # Forward everything after first [--] to stdingargs.bash.
      option_stdin_args+=("$@")
      shift $#
      break
      ;;
    *)
      # Forward uncaught flags to picker
      option_picker_args+=("$item")
      ;;
    esac
  done

  local picker_cmd="run_picker_$option_target_picker"
  if ! [[ "$(type -t "$picker_cmd")" == 'function' ]]; then
    help "Not valid target picker [$option_target_picker]"
  fi

  # ===========================================================================
  # Act / Run pickers
  #

  if [[ -n "$action" ]]; then
    #
    # Action
    #

    # Run supplied action
    __debug_lines "Action = $action"
    if test "$(type -t "picker__$action")" = 'function'; then
      "picker__$action"
      return
    else
      help "Action [$action] not yet implemented."
    fi

  else
    #
    # Handle inputs
    #

    local entries=()

    # collect entries
    function on_input {
      entries+=("$1")
    }

    # call run_picker_fzf
    function on_finish {
      if [[ "${#entries[@]}" -gt 0 ]]; then
        echo-lines -- "${entries[@]}" | "$picker_cmd" -- "${option_picker_args[@]}"
      else
        run_picker_fzf "${option_picker_args[@]}"
      fi
    }

    stdinargs "${option_stdin_args[@]}"

  # # Run picker
  # if test "$(type -t "picker__$action")" = 'function'; then
  #   "picker__$action"
  #   return
  # else
  #   echo-style --error="Action [$action] not yet implemented." >/dev/stderr
  #   return 78 # ENOSYS 78 Function not implemented
  # fi
  fi

)

# fire if invoked standalone
if test "$0" = "${BASH_SOURCE[0]}"; then
  fzf_helper "$@"
fi
