    # =====================================
    # Help

    function help {
        cat <<-EOF >/dev/stderr
			ABOUT:

			USAGE:
			echo-lines -- a b c | fzf-helper [...<options] [-- [...<picker_options>]]

			ACTIONS/PICKERS:
			$(declare -F | awk '{print "    " $3}' | grep 'picker__' | sed 's/picker__//')
		EOF
        if [[ $# -ne 0 ]]; then
            echo-error "$@"
        fi
        return 22 # EINVAL 22 Invalid argument
    }

    # ===========================================================================
    # Arguments
