  run_picker_fzf() {

    local fzf_options=() fzf_options_use_defaults='yes' fzf_args=()
    while test "$#" -ne 0; do
      item="$1"
      shift
      case "$item" in
      '--no-defaults')
        fzf_options_use_defaults='no'
        ;;
      '--')
        fzf_args+=("$@")
        shift $#
        break
        ;;
      esac
